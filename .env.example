# Copy only for your own local development. Never use these placeholders in production.
DATABASE_URL="postgresql://csc_dev:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/csc_reviewer?schema=public"
# Hosted migrations may use a separate direct/session connection (port 5432).
# Runtime continues to use DATABASE_URL; never commit either real connection.
# DIRECT_URL=
POSTGRES_USER=csc_dev
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=csc_reviewer
APP_URL=http://localhost:3000
# Registration defaults to enabled in development and disabled in production.
# Enable on a real deployment only after operator/privacy/recovery readiness.
# REGISTRATION_ENABLED=false
# Exact trusted browser origin for authenticated JSON writes; HTTPS on real deployments.
# Staff-only PDFs are stored outside public/. Use a durable private volume on the worker.
PDF_PRIVATE_DIR=.local/editions
# Set to an installed Chromium executable if not using Playwright's browser cache.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# Illustrative catalog prices in Philippine pesos; validated at startup.
PRICE_BASIC_PHP=99
PRICE_COMPLETE_PHP=199
PRICE_PREMIUM_PHP=399
# Mock checkout is available only when NODE_ENV is not production.
# GCash via PayMongo has a sandbox-only adapter; production checkout stays disabled.
PAYMENT_PROVIDER=mock
# Optional structured API completion logs; private error events are always emitted.
# Never add raw request bodies, URLs, headers or exception details to these logs.
# OBSERVABILITY_LOGS=false

# Account verification/recovery and transactional mail.
# Disabled by default in production; development defaults to private file delivery.
# MAIL_TRANSPORT=file
# MAIL_PRIVATE_DIR=.local/mail
# Production: set a unique 64-hex encryption key through secure environment settings.
# MAIL_ENCRYPTION_KEY=
# SMTP submission requires a verified sender. Port 465 uses TLS; others require STARTTLS.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# OPERATOR_EMAIL=
# Local SMTP test sinks only; forbidden in production or for remote hosts.
# SMTP_ALLOW_INSECURE=false

# Optional GCash merchant sandbox. Never use live keys or public/client variables.
# PAYMENT_PROVIDER=paymongo
# PAYMONGO_MODE=test
# GCASH_CHECKOUT_ENABLED=false
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=
# See docs/GCASH_OPERATIONS.md for actual sandbox verification and merchant setup.
# PAYMONGO_TEST_API_ORIGIN is reserved for disposable automated tests; do not set it here.

# Private remote PDFs: same project/bucket on trusted web and separate worker.
# See docs/PDF_STORAGE.md. Never set NEXT_PUBLIC credentials or public buckets.
# PDF_STORAGE=supabase
# PDF_SUPABASE_URL=https://PROJECT_REF.supabase.co
# PDF_SUPABASE_BUCKET=private-editions
# PDF_SUPABASE_SERVICE_KEY=
# PDF_OPERATOR_EMAIL=
