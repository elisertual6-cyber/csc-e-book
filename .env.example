# Copy only for your own local development. Never use these placeholders in production.
DATABASE_URL="postgresql://csc_dev:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/csc_reviewer?schema=public"
POSTGRES_USER=csc_dev
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=csc_reviewer
APP_URL=http://localhost:3000
# Registration defaults to enabled in development and disabled in production.
# Enable on a real deployment only after operator/privacy/recovery readiness.
# REGISTRATION_ENABLED=false
# Exact trusted browser origin for authenticated JSON writes; HTTPS on real deployments.
# Staff-only PDFs are stored outside public/. Use a durable private volume on the worker.
PDF_PRIVATE_DIR=.local/editions
# Set to an installed Chromium executable if not using Playwright's browser cache.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# Illustrative catalog prices in Philippine pesos; validated at startup.
PRICE_BASIC_PHP=99
PRICE_COMPLETE_PHP=199
PRICE_PREMIUM_PHP=399
# Future integrations: do not enable real checkout until sandbox validation.
PAYMENT_PROVIDER=mock
