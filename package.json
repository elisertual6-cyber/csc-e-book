{
  "name": "csc-e-book",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/check-build-traces.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:db": "tsx scripts/check-db.ts",
    "content:check": "tsx scripts/check-content.ts",
    "local:env": "node scripts/local-env.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "user:role": "tsx scripts/set-role.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "postinstall": "prisma generate",
    "test:commerce": "node scripts/e2e.mjs --config playwright.commerce.config.ts",
    "mail:work": "tsx scripts/mail-worker.ts",
    "test:gcash": "node scripts/e2e.mjs --config playwright.gcash.config.ts",
    "backup:local": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "test:a11y": "node scripts/e2e.mjs accessibility.spec.ts",
    "test:backup": "node scripts/check-backup.mjs",
    "test:load": "node scripts/e2e.mjs --config playwright.load.config.ts",
    "test:readiness": "node scripts/e2e.mjs --config playwright.readiness.config.ts",
    "content:export": "tsx scripts/export-draft-pack.ts",
    "build:check": "node scripts/check-build-traces.mjs",
    "db:check-schema": "tsx scripts/check-schema.ts",
    "content:import-drafts": "node --conditions=react-server --import tsx scripts/import-numerical-drafts.ts",
    "test:content-import": "node scripts/e2e.mjs --config playwright.operator-import.config.ts",
    "test:a11y:authenticated": "node scripts/e2e.mjs --config playwright.auth-a11y.config.ts",
    "pdf:render": "node --conditions=react-server --import tsx scripts/pdf-worker.ts",
    "pdf:storage:check": "node --conditions=react-server --import tsx scripts/check-pdf-storage.ts",
    "backup:remote:drill": "node --conditions=react-server --import tsx scripts/remote-recovery.ts",
    "test:remote-recovery": "node scripts/check-remote-recovery.mjs",
    "mail:check": "tsx scripts/check-mail.ts",
    "mail:operator:work": "tsx scripts/operator-mail-worker.ts",
    "mail:account:work": "tsx scripts/account-mail-worker.ts",
    "test:mail:automatic": "node scripts/e2e.mjs --config playwright.automatic-mail.config.ts",
    "content:export-practice": "tsx scripts/export-practice-review.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^15.0.3",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
